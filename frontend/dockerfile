# Build stage
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Serve stage
FROM nginx:alpine 

COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/css/ /usr/share/nginx/html/assets/css/
COPY --from=build /app/js/ /usr/share/nginx/html/assets/js/
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
